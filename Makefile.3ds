# Makefile.3ds — Turok: Dinosaur Hunter, Nintendo 3DS (devkitARM + libctru + Citro3D)
#
# A SECOND, additive build system alongside tools/build_port.sh (the PC build). The original
# game tree (src/PR/tengine/**) is compiled UNCHANGED, gated by -DPLATFORM_PORT (PC+3DS shared)
# and -DPLATFORM_3DS (3DS-only). Architecture mirrors the sibling Banjo-Kazooie / Perfect Dark
# 3DS ports: original game C -> libultra shim + Fast3D + audio HLE + asset loader (port/) ->
# Citro3D/PICA200 backend (port/fast3d/gfx_citro3d.cpp + gfx_3ds.c, already vendored from PD).
#
# Incremental milestones:
#   make -f Makefile.3ds objects     # 3DS-M0 : compile the whole tree to .o (ARM)
#   make -f Makefile.3ds             # full link -> build_3ds/turok.3dsx
#
# Run in Mandarine:  ~/Desktop/citra/mandarine.AppImage build_3ds/turok.3dsx
# Assets on SD:      sdmc:/3ds/turok/baserom.us.v12.z64

ifeq ($(strip $(DEVKITPRO)),)
DEVKITPRO := /opt/devkitpro
endif

DEVKITARM ?= $(DEVKITPRO)/devkitARM
PORTLIBS  := $(DEVKITPRO)/portlibs/3ds
LIBCTRU   := $(DEVKITPRO)/libctru
TOOLS     := $(DEVKITPRO)/tools/bin

PREFIX   := $(DEVKITARM)/bin/arm-none-eabi-
CC       := $(PREFIX)gcc
CXX      := $(PREFIX)g++
LD       := $(PREFIX)g++
PICASSO  := $(TOOLS)/picasso
BIN2S    := $(TOOLS)/bin2s
TDSXTOOL := $(TOOLS)/3dsxtool

# --- CIA packaging (HOME-menu installable) -----------------------------------
# makerom + bannertool are not in devkitPro; their binaries live in tools/3ds-cia/ (see tools/3ds-cia/README.md).
# Inputs are user-supplied (gitignored, like the ROM): turok.jpg (banner+icon art) + turok.wav (banner audio).
BANNERTOOL ?= tools/3ds-cia/bannertool
MAKEROM    ?= tools/3ds-cia/makerom
CONVERT    ?= convert
FFMPEG     ?= ffmpeg
CIA_DIR    := build_3ds/cia
CIA_IMAGE  ?= turok.jpg
CIA_ICON   ?= turok.ico
CIA_AUDIO  ?= turok.wav
CIA_ROM    ?= baserom.us.v12.z64
CIA_ROMFS  := $(CIA_DIR)/romfs
APP_TITLE        ?= Turok
APP_DESC         ?= Turok: Dinosaur Hunter
APP_AUTHOR       ?= Acclaim / Iguana
APP_PRODUCT_CODE ?= CTR-P-TURK
APP_UNIQUE_ID    ?= 0xf7053

BUILD   := build_3ds
OBJDIR  := $(BUILD)/obj
TARGET  := turok
OUTPUT  := $(BUILD)/$(TARGET)

# --- architecture / flags (identical to banjo + PD 3DS builds) ---------------
ARCH := -march=armv6k -mtune=mpcore -mfloat-abi=hard -mtp=soft

# Platform gates. PLATFORM_PORT guards the endian/null-tolerance work in src/PR/tengine;
# PLATFORM_3DS is 3DS-only. (No -DSHIP_IT vs the PC build? The PC build sets it; keep parity.)
PORT_DEFINES := -DPLATFORM_PORT=1 -DPLATFORM_3DS=1 -D__3DS__ -D_3DS -DPD_BAKE_THREAD=1

# Mirror tools/build_port.sh GAME_D exactly (minus host-only bits).
GAME_DEFINES := -D_LANGUAGE_C=1 -D_MIPS_SZLONG=32 -DF3DEX_GBI -DN_MICRO -D_FINALROM -DNDEBUG -DSHIP_IT
DEFINES      := $(PORT_DEFINES) $(GAME_DEFINES)

# Game-tree includes (mirror GAME_I) + libctru/citro3d.
GAME_INC := -Isrc/PR/tengine -Ilib/ultralib/include -Ilib/ultralib/include/PR -Iport/include \
            -I$(LIBCTRU)/include -I$(PORTLIBS)/include
# Port-layer includes (mirror PORT_I) + fast3d (turok_gfx.c bridges to gfx_api.h / the backends).
PORT_INC := -Ilib/ultralib/include -Ilib/ultralib/include/PRinternal -Iport/include \
            -Iport/fast3d -Iport/fast3d/shaders \
            -I$(LIBCTRU)/include -I$(PORTLIBS)/include
GU_INC   := $(PORT_INC) -Ilib/ultralib/include/PR
# libaudio (turoksnd/abi) includes (mirror TSND_I).
TSND_INC := -Ituroksnd/abi -Ilib/ultralib/include/PR -Ilib/ultralib/include -Ituroksnd/abi/buildss \
            -Iport/include -I$(LIBCTRU)/include
# Fast3D C++ includes (mirror F3D_I) — deliberately NOT -Isrc/PR/tengine.
F3D_INC  := -Ilib/ultralib/include -Iport/fast3d -Iport/fast3d/shaders -Iport/include \
            -I$(LIBCTRU)/include -I$(PORTLIBS)/include

OPT  := -O2 -ffunction-sections -fdata-sections -mword-relocations
# devkitARM gcc 15 promotes legacy-C constructs to HARD ERRORS that plain -w doesn't suppress
# (the PC build's older gcc treated them as warnings). Downgrade them back — the original IRIX
# source is full of implicit-int typedefs / K&R-isms / pointer puns that compiled fine for decades.
WARN := -w -Wno-implicit-int -Wno-implicit-function-declaration -Wno-int-conversion \
        -Wno-incompatible-pointer-types -Wno-builtin-declaration-mismatch \
        -Wno-return-mismatch -Wno-declaration-missing-parameter-type

# -fno-short-enums is CRITICAL: devkitARM ARM-EABI defaults to PACKED enums, which breaks the
# game's -1 enum sentinels and mis-lays every struct with an enum field. -fcommon: the game
# relies on tentative-definition merging (it's pre-C99-strict). -fwrapv/-fno-strict-aliasing
# match the PC build's tolerance of the original IRIX code.
CBASE   := $(ARCH) $(OPT) $(WARN) $(DEFINES) -std=gnu11 -fcommon -fno-strict-aliasing -fwrapv -fno-short-enums
CXXBASE := $(ARCH) $(OPT) $(WARN) $(DEFINES) -std=gnu++20 -fno-rtti -fno-exceptions

# Force-include the port compat shim into every game TU (mirrors build_port.sh FI): the qsort rename,
# the float fmodf prototype, and the turok_wrap_pi inline the game references. PLATFORM_PORT-gated, portable.
GAME_CFLAGS := $(CBASE) -include port/include/turok_port.h $(GAME_INC)
PORT_CFLAGS := $(CBASE) $(PORT_INC)
GU_CFLAGS   := $(CBASE) $(GU_INC)
TSND_CFLAGS := $(CBASE) $(TSND_INC)
F3D_CFLAGS  := $(CXXBASE) $(F3D_INC)

# NOTE: NO --allow-multiple-definition. The only libultra/libctru symbol collision was osGetTime (now
# gated out of os_shim.c on 3DS), and that flag silently let Turok's osGetTime override libctru's → the
# pre-main boot HANG. Without the flag, any future collision is a hard error, not a silent override.
LDFLAGS := $(ARCH) -specs=$(DEVKITARM)/arm-none-eabi/lib/3dsx.specs \
           -Wl,--gc-sections -Wl,-Map,$(OUTPUT).map
LIBS    := -L$(LIBCTRU)/lib -L$(PORTLIBS)/lib -lcitro3d -lctru -lz -lm

# --- sources -----------------------------------------------------------------
# Game engine (exclude coll.c — stale vs CCollisionInfo2, same as the PC build).
GAME_C := $(filter-out src/PR/tengine/coll.c, $(wildcard src/PR/tengine/*.c))
# libaudio synth + CSP music (real al* — so the audio_lib_stub.c is excluded from PORT_C below).
TSND_C := $(wildcard turoksnd/abi/*.c)
# libultra gu matrix utils (the 5 the PC build compiles).
GU_C   := lib/ultralib/src/gu/mtxutil.c lib/ultralib/src/gu/ortho.c lib/ultralib/src/gu/perspective.c \
          lib/ultralib/src/gu/lookat.c lib/ultralib/src/gu/lookatref.c
# Port layer: all port/src/*.c EXCEPT the PC-only SDL audio sink + the superseded libaudio stub.
# input.c is KEPT (it's the platform-agnostic pad seam; input_3ds.c only adds the HID poll). The 3DS
# TUs (audio_3ds/input_3ds/sys_3ds/stderr_3ds) are picked up by the wildcard (each #ifdef PLATFORM_3DS).
PORT_C := $(filter-out port/src/audio.c port/src/audio_lib_stub.c, \
            $(wildcard port/src/*.c)) \
          port/fast3d/gfx_3ds.c
# Port C++: the fast3d driver + Citro3D backend (NOT gfx_opengl/sdl2/osmesa/egl).
PORT_CXX := port/fast3d/gfx_pc.cpp port/fast3d/gfx_cc.cpp port/fast3d/gfx_citro3d.cpp

obj = $(OBJDIR)/$(1:.c=.o)
GAME_O := $(GAME_C:%=$(OBJDIR)/%.o)
TSND_O := $(TSND_C:%=$(OBJDIR)/%.o)
GU_O   := $(GU_C:%=$(OBJDIR)/%.o)
PORT_O := $(PORT_C:%=$(OBJDIR)/%.o)
PCXX_O := $(PORT_CXX:%=$(OBJDIR)/%.o)
SHADER_O := $(OBJDIR)/shaders/gfx_citro3d_shbin.o

ALL_O := $(GAME_O) $(TSND_O) $(GU_O) $(PORT_O) $(PCXX_O)

.PHONY: all objects clean cia
.DEFAULT_GOAL := all
all: $(OUTPUT).3dsx
objects: $(ALL_O)

# Per-tree compile rules (object name = $(OBJDIR)/<path>.o so trees don't collide).
$(OBJDIR)/turoksnd/abi/%.c.o: turoksnd/abi/%.c
	@mkdir -p $(@D)
	$(CC) $(TSND_CFLAGS) -c $< -o $@
$(OBJDIR)/lib/ultralib/src/gu/%.c.o: lib/ultralib/src/gu/%.c
	@mkdir -p $(@D)
	$(CC) $(GU_CFLAGS) -c $< -o $@
$(OBJDIR)/src/PR/tengine/%.c.o: src/PR/tengine/%.c
	@mkdir -p $(@D)
	$(CC) $(GAME_CFLAGS) -c $< -o $@
$(OBJDIR)/port/fast3d/%.cpp.o: port/fast3d/%.cpp
	@mkdir -p $(@D)
	$(CXX) $(F3D_CFLAGS) -c $< -o $@
$(OBJDIR)/port/fast3d/%.c.o: port/fast3d/%.c
	@mkdir -p $(@D)
	$(CC) $(PORT_CFLAGS) -c $< -o $@
$(OBJDIR)/port/src/%.c.o: port/src/%.c
	@mkdir -p $(@D)
	$(CC) $(PORT_CFLAGS) -c $< -o $@

# PICA200 vertex shader: picasso .v.pica -> .shbin, bin2s embeds it (+ regenerates the header).
$(SHADER_O): port/fast3d/shaders/gfx_citro3d.v.pica
	@mkdir -p $(@D)
	$(PICASSO) -o $(BUILD)/gfx_citro3d.shbin $<
	$(BIN2S) -a 4 -H port/fast3d/shaders/gfx_citro3d_shbin.h $(BUILD)/gfx_citro3d.shbin | $(CC) $(ARCH) -x assembler -c - -o $@

$(OUTPUT).elf: $(ALL_O) $(SHADER_O)
	$(LD) $(LDFLAGS) $(ALL_O) $(SHADER_O) $(LIBS) -o $@
$(OUTPUT).3dsx: $(OUTPUT).elf
	$(TDSXTOOL) $< $@
	@echo "[3ds] built $@"

# --- CIA (installable): resize turok.jpg -> 256x128 banner + 48x48 icon, pack banner (with turok.wav) + SMDH.
cia: $(OUTPUT).cia
$(CIA_DIR)/banner.png: $(CIA_IMAGE)
	@mkdir -p $(@D)
	$(CONVERT) $< -resize 256x128! $@
$(CIA_DIR)/icon.png: $(CIA_ICON)
	@mkdir -p $(@D)
	@frame=$$(identify "$(CIA_ICON)" | awk '{split($$3,d,"x"); print d[1]*d[2]" "NR-1}' | sort -n | tail -1 | awk '{print $$2}'); \
	$(CONVERT) "$(CIA_ICON)[$$frame]" -resize 48x48^ -gravity center -extent 48x48 $@
$(CIA_DIR)/icon.smdh: $(CIA_DIR)/icon.png
	$(BANNERTOOL) makesmdh -s "$(APP_TITLE)" -l "$(APP_DESC)" -p "$(APP_AUTHOR)" -i $< -o $@ \
		-r regionfree -f visible,allow3d,recordusage
# HOME banner audio must be stereo 16-bit PCM (a mono CWAV plays silent) — normalize the user WAV first.
$(CIA_DIR)/banner_audio.wav: $(CIA_AUDIO)
	@mkdir -p $(@D)
	$(FFMPEG) -y -loglevel error -i $(CIA_AUDIO) -ac 2 -ar 32000 -c:a pcm_s16le $@
$(CIA_DIR)/banner.bnr: $(CIA_DIR)/banner.png $(CIA_DIR)/banner_audio.wav
	$(BANNERTOOL) makebanner -i $(CIA_DIR)/banner.png -a $(CIA_DIR)/banner_audio.wav -o $@
# stage the retail ROM into the CIA RomFS so the install is self-contained on any console
$(CIA_ROMFS)/baserom.us.v12.z64: $(CIA_ROM)
	@mkdir -p $(CIA_ROMFS)
	cp -f $(CIA_ROM) $@
$(OUTPUT).cia: $(OUTPUT).elf $(CIA_DIR)/icon.smdh $(CIA_DIR)/banner.bnr $(CIA_ROMFS)/baserom.us.v12.z64 port/3ds/turok.rsf
	$(MAKEROM) -f cia -target t -exefslogo -elf $(OUTPUT).elf -rsf port/3ds/turok.rsf \
		-icon $(CIA_DIR)/icon.smdh -banner $(CIA_DIR)/banner.bnr -o $@ \
		-DAPP_TITLE="$(APP_TITLE)" -DAPP_PRODUCT_CODE="$(APP_PRODUCT_CODE)" -DAPP_UNIQUE_ID="$(APP_UNIQUE_ID)" \
		-DAPP_ROMFS_DIR="$(CIA_ROMFS)"
	@echo "[3ds] built $@"

clean:
	rm -rf $(OBJDIR) $(OUTPUT).elf $(OUTPUT).3dsx $(OUTPUT).cia $(CIA_DIR) $(OUTPUT).map $(BUILD)/gfx_citro3d.shbin

# ─── archive.org release pipeline (mirrors ../forsaken Makefile.3ds `release`) ───────
#
#   make -f Makefile.3ds release          # clean build -> turok.cia (+ self-contained
#                                          # .3dsx), both with the retail ROM bundled;
#                                          # prints artifacts + SHA1, ready to upload.
#   make -f Makefile.3ds archive-upload    # push those artifacts to archive.org/details/turok3ds
#   make -f Makefile.3ds archive           # release + archive-upload in one shot.
#
# The CIA embeds the retail ROM in its RomFS (self-contained install, no SD-card ROM
# needed) per the project decision; the release .3dsx bundles the same ROM via --romfs
# so the HBL binary is equally self-contained. Upload uses the `ia` CLI (internetarchive
# module) with the S3 keys in ~/.config/internetarchive/ia.ini — same as forsaken3ds.
IA          ?= $(HOME)/miniconda3/bin/ia
IA_ITEM     ?= turok3ds
RELEASE_3DSX := $(OUTPUT).3dsx

.PHONY: release release-3dsx archive-upload archive

# Self-contained HBL binary: the ELF + SMDH icon + the ROM bundled as RomFS (so the
# .3dsx needs no SD-card ROM either), overwriting the plain dev .3dsx from `all`.
release-3dsx: $(OUTPUT).elf $(CIA_DIR)/icon.smdh $(CIA_ROMFS)/baserom.us.v12.z64
	@rm -f $(RELEASE_3DSX)
	$(TDSXTOOL) $(OUTPUT).elf $(RELEASE_3DSX) --smdh=$(CIA_DIR)/icon.smdh --romfs=$(CIA_ROMFS)
	@echo "[release] self-contained 3dsx (ROM bundled): $(RELEASE_3DSX)"

# Force a clean build so no stale diagnostic .o files (e.g. a TUROK_DIAG_APPINIT build)
# survive into a shipped artifact — same guard rationale as forsaken's `release`.
release:
	@echo "[release] clean build for a fresh, diagnostic-free tree..."
	@$(MAKE) -f Makefile.3ds clean
	@echo "[release] building self-contained CIA + 3dsx (retail ROM bundled)..."
	@$(MAKE) -f Makefile.3ds $(OUTPUT).cia release-3dsx
	@echo
	@echo "============================================================"
	@echo "[release] DONE — artifacts ready for archive.org/details/$(IA_ITEM):"
	@ls -lh $(OUTPUT).cia $(RELEASE_3DSX) 2>/dev/null
	@echo "[release] SHA1:"
	@sha1sum $(OUTPUT).cia $(RELEASE_3DSX) 2>/dev/null
	@echo "============================================================"

# Push the CIA + 3dsx to archive.org. Metadata mirrors the forsaken3ds item
# (mediatype/collection/creator/subject/description/language). Re-running replaces the
# files in place at the same URL and keeps prior versions in the item history.
archive-upload: $(OUTPUT).cia $(RELEASE_3DSX)
	@test -x "$(IA)" || { echo "[archive] ERROR: ia CLI not found at $(IA) (override with IA=<path>)"; exit 1; }
	@echo "[archive] uploading to archive.org/details/$(IA_ITEM) ..."
	$(IA) upload $(IA_ITEM) $(OUTPUT).cia $(RELEASE_3DSX) \
		--retries 5 \
		--metadata="mediatype:software" \
		--metadata="collection:open_source_software" \
		--metadata="title:Turok: Dinosaur Hunter (3DS Port)" \
		--metadata="creator:Colby Shores (3DS Port)" \
		--metadata="language:eng" \
		--metadata="subject:3DS" --metadata="subject:Homebrew" --metadata="subject:Turok" \
		--metadata="subject:Nintendo 64" --metadata="subject:Port" --metadata="subject:Pica200" \
		--metadata="subject:Citro3D" --metadata="subject:Dinosaur Hunter" \
		--metadata="description:A homebrew port of <b>Turok: Dinosaur Hunter</b> (N64) to the Nintendo 3DS, built from the original Iguana engine source. Renders through a Fast3D-to-Citro3D (PICA200) pipeline with stereoscopic 3D, the classic-ABI software audio synth (SFX + music), and save support. The .cia is a self-contained HOME-menu install; the .3dsx runs from the Homebrew Launcher. Install the CIA with FBI (open the .cia and choose Install)."
	@echo "[archive] done -> https://archive.org/details/$(IA_ITEM)"

archive: release archive-upload
